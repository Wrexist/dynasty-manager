{
  "name": "dynasty-manager",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "analyze": "ANALYZE=true vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "size:check": "node scripts/check-eager-bundle.mjs",
    "preflight": "npm run lint && npm run typecheck && npm run test && npm run build && npm run size:check",
    "cap:sync": "npm run build && npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "ship": "bash scripts/ship.sh",
    "branch": "bash scripts/new-branch.sh",
    "scrape:icons": "node scripts/scrapeSoFIFAIcons.mjs",
    "scrape:icons:setup": "playwright install chromium",
    "analyze-fc26": "node scripts/analyzeFC26.mjs",
    "process-fc26": "node scripts/processFC26.mjs",
    "validate-cp": "node scripts/validateCommunityPack.mjs",
    "ads:model": "node marketing/ads/unit-economics.mjs",
    "check:observability": "node scripts/check-observability.mjs",
    "redeem-code": "node scripts/gen-redeem-code.mjs",
    "prepare": "husky",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/check-marketing-version.mjs",
    "whats-new": "node scripts/add-whats-new-entry.mjs",
    "whats-new:check": "node scripts/check-whats-new.mjs",
    "whats-new:seal": "node scripts/seal-whats-new.mjs",
    "whats-new:plan": "node scripts/seal-whats-new.mjs --dry-run",
    "whats-new:append-pr": "node scripts/append-pending-from-pr.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.3.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/oswald": "^5.2.8",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@revenuecat/purchases-capacitor": "^12.3.2",
    "@revenuecat/purchases-capacitor-ui": "^12.3.2",
    "@sentry/react": "^10.49.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.462.0",
    "pixi.js": "^8.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1",
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.17",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.4.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5.10",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^7.3.2",
    "vitest": "^3.2.4"
  }
}
