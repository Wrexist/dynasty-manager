<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Dynasty Manager</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- Required when TARGETED_DEVICE_FAMILY includes iPad (=2). Without
	     this, App Store validation rejects with ITMS-90474 because iPad
	     multitasking requires either all four orientations OR an explicit
	     opt-out via UIRequiresFullScreen. Dynasty Manager is a portrait-
	     only game, so we opt out of multitasking on iPad too. -->
	<key>UIRequiresFullScreen</key>
	<true/>
	<!-- MUST be false: @capacitor/status-bar in src/main.tsx calls
	     StatusBar.setStyle / setBackgroundColor which use UIApplication-
	     style APIs. With this set to true, iOS 17+ raises
	     NSInternalInconsistencyException and iOS 15.x can crash. -->
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<!-- Export compliance (EAR 740.17(b)(1)): NO — app does not implement
	     custom/proprietary crypto. Networking uses only platform TLS (HTTPS)
	     for Sentry and RevenueCat; no additional encryption registration is
	     required. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
</dict>
</plist>
