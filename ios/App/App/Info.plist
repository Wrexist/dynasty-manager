<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Dynasty Manager</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- Export compliance (EAR 740.17(b)(1)): NO — app does not implement
	     custom/proprietary crypto. Networking uses only platform TLS (HTTPS)
	     for Sentry, RevenueCat, and Google Mobile Ads (linked but dormant in
	     v1); no additional encryption registration is required. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
	<!-- Google Mobile Ads SDK is bundled via @capacitor-community/admob.
	     The SDK requires GADApplicationIdentifier in Info.plist or it
	     crashes the app on launch — even if AdMob.initialize() is never
	     called. NATIVE_ADS_READY=false in src/utils/ads.ts keeps the SDK
	     dormant. SKAdNetworkItems remains removed so App Privacy can stay
	     "no tracking" until ads are actually enabled in a future build. -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-2286247955186424~9847041449</string>
	<!-- NSUserTrackingUsageDescription is required by App Store review
	     (error ITMS-90683) because the bundled AdMob SDK references the
	     App Tracking Transparency API, even when the SDK stays dormant.
	     The string is also localized per-locale via the *.lproj/InfoPlist.strings
	     files; this entry is the default fallback. ATT is only requested
	     once NATIVE_ADS_READY flips to true in src/utils/ads.ts. -->
	<key>NSUserTrackingUsageDescription</key>
	<string>We use your advertising identifier to show relevant rewarded ads so you can earn free pack openings and in-game rewards.</string>
</dict>
</plist>
