# Dynasty Manager — Environment Variables
# Copy this file to .env.local and fill in production values before release.

# Sentry crash reporting DSN (optional — omit to disable)
VITE_SENTRY_DSN=

# Analytics endpoint (optional — omit to keep analytics local-only / dev console).
# Only receives events AFTER the user grants consent on first launch; never
# collects names, save contents, or device fingerprints. See src/utils/analytics.ts.
VITE_ANALYTICS_ENDPOINT=

# RevenueCat API key (falls back to test key if not set)
# Use 'appl_xxx' for iOS builds, 'goog_xxx' for Android builds
VITE_REVENUECAT_API_KEY=appl_ebrTKjNmobKuvBwOLPIWcMTYiUq

# App Store screenshot build — set to "1" to hide the Shop entry from the
# More drawer and short-circuit the Shop page. RevenueCat code stays intact.
# To reset: unset the variable (or set to anything other than "1") and rebuild.
VITE_DISABLE_IAP=
