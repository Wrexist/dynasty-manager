# Dynasty Manager — Environment Variables
# Copy this file to .env.local and fill in production values before release.

# Sentry crash reporting DSN (optional — omit to disable)
VITE_SENTRY_DSN=

# Analytics endpoint (optional — omit to keep analytics local-only / dev console).
# Only receives events AFTER the user grants consent on first launch; never
# collects names, save contents, or device fingerprints. See src/utils/analytics.ts.
VITE_ANALYTICS_ENDPOINT=

# RevenueCat SDK keys. RevenueCat public SDK keys are designed to ship in the
# client, but a real key should still NOT live in this tracked example file —
# keep the real value only in untracked .env.local and CI secrets.
#
# RevenueCat issues a SEPARATE key per store. Set the platform-specific keys for
# production builds; purchases.ts picks the right one via Capacitor.getPlatform().
VITE_REVENUECAT_IOS_API_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_REVENUECAT_ANDROID_API_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Single-key fallback used when the platform-specific var above is unset
# (kept for backwards compatibility with existing iOS builds / the test key).
VITE_REVENUECAT_API_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
