# Dynasty Manager — Environment Variables
# Copy this file to .env.local and fill in production values before release.

# Sentry crash reporting DSN (optional — omit to disable)
VITE_SENTRY_DSN=

# Analytics endpoint (optional — omit to keep analytics local-only / dev console).
# Only receives events AFTER the user grants consent on first launch; never
# collects names, save contents, or device fingerprints. See src/utils/analytics.ts.
VITE_ANALYTICS_ENDPOINT=

# RevenueCat SDK key. RevenueCat public SDK keys are designed to ship in the
# client, but a real key should still NOT live in this tracked example file —
# keep the real value only in untracked .env.local and CI secrets.
# Use 'appl_xxx' for iOS builds, 'goog_xxx' for Android builds.
VITE_REVENUECAT_API_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloud Save backend (Supabase — Online Slice 1). OPTIONAL: leave both blank to
# keep cloud backup disabled (the Settings "Cloud Backup" section won't render
# and supabase-js is never loaded). To enable, provision the dynasty-manager
# Supabase project, apply supabase/migrations/0001_cloud_saves.sql, turn on
# anonymous sign-ins, and set both values here / in CI. The anon key is a public
# client key (safe to ship), but keep the real value out of this tracked file.
# See docs/cloud-save-setup.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sign in with Apple (Online Slice 1, phase 1b). The app's Apple client id —
# normally the iOS bundle identifier registered as an authorized client on the
# Supabase Apple provider. Leave blank to keep Apple sign-in hidden (players stay
# anonymous guests). Only used on native iOS builds. See docs/cloud-save-setup.md.
VITE_APPLE_CLIENT_ID=
