default_platform(:ios)

platform :ios do
  desc "Fetch certs via match, build the iOS app, upload to TestFlight"
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id:                ENV["ASC_KEY_ID"],
      issuer_id:             ENV["ASC_ISSUER_ID"],
      key_content:           ENV["ASC_KEY_P8"],
      is_key_content_base64: false,
      duration:              1200,
      in_house:              false
    )

    match(
      type:           "appstore",
      app_identifier: "com.dynastymanager",
      git_url:        ENV["MATCH_GIT_URL"],
      readonly:       false,
      api_key:        api_key
    )

    update_code_signing_settings(
      path:                  "ios/App/App.xcodeproj",
      use_automatic_signing: false,
      bundle_identifier:     "com.dynastymanager",
      team_id:               ENV["sigh_com.dynastymanager_appstore_team-id"],
      profile_name:          ENV["sigh_com.dynastymanager_appstore_profile-name"],
      code_sign_identity:    "Apple Distribution"
    )

    build_app(
      project:       "ios/App/App.xcodeproj",
      scheme:        "App",
      configuration: "Release",
      export_method: "app-store",
      clean:         true
    )

    upload_to_testflight(
      api_key:                           api_key,
      skip_waiting_for_build_processing: true
    )
  end
end

platform :android do
  # Uploads an AAB that android-build.yml already built and signed — this lane
  # never builds. Google refuses API uploads until the app has one release made
  # by hand in the Console (docs/android-launch.md §6), so the very first AAB
  # goes up manually and every later one through here.
  desc "Upload a signed release AAB to a Google Play testing track"
  lane :upload do
    upload_to_play_store(
      package_name:   "com.dynastymanager",
      track:          ENV.fetch("PLAY_TRACK", "internal"),
      aab:            ENV.fetch("AAB_PATH"),
      json_key_data:  ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON"),
      # 'draft' is the only status Play accepts while the app itself is still
      # a draft (nothing rolled out anywhere yet).
      release_status: ENV.fetch("PLAY_RELEASE_STATUS", "completed"),
      # The listing, graphics and release notes are managed in the Console
      # (marketing/play/) — an upload must never overwrite them.
      skip_upload_metadata:    true,
      skip_upload_changelogs:  true,
      skip_upload_images:      true,
      skip_upload_screenshots: true
    )
  end
end
