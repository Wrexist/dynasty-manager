default_platform(:ios)

platform :ios do
  desc "Build and upload a TestFlight beta via Match (readonly) + Pilot"
  lane :beta do
    setup_ci

    match(
      type: "appstore",
      readonly: true,
      api_key_path: ENV["ASC_API_KEY_PATH"],
    )

    increment_build_number(
      xcodeproj: "ios/App/App.xcodeproj",
      build_number: ENV.fetch("GITHUB_RUN_NUMBER"),
    )

    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
    )

    pilot(
      api_key_path: ENV["ASC_API_KEY_PATH"],
    )
  end
end

